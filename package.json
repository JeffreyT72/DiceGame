{
  "name": "blackjack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test",
    "start": "node server/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "phaser": "^3.90.0",
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^10.13.0",
    "vite": "^6.3.5"
  }
}
